# Solvence Local Development Environment Variables
# Copy this file to .env or export these variables in your shell.
# NEVER commit the actual .env file with secrets.

# Backend Database Credentials
DB_URL=jdbc:postgresql://127.0.0.1:5432/solvence
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
