# Solvence Local Development Environment Variables
# Copy this file to .env or export these variables in your shell.
# NEVER commit the actual .env file with secrets.

# Backend Database Credentials
DB_URL=jdbc:postgresql://127.0.0.1:5432/solvence
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Authentication Security (Phase 2)
# Must be at least 256 bits (32 characters) long
JWT_SECRET=<set-a-long-random-secret-min-32-chars>
JWT_EXPIRATION_MS=86400000

# Optional Development User Seed
DEV_USER_SEED_ENABLED=false
DEV_USER_PASSWORD=<optional-development-only-password>

